# Local Stripe TEST MODE only. Production selects live mode in server secrets.
# Never place Stripe or Supabase server secrets in Vite/browser variables.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_TEST_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_CLI_SECRET
STRIPE_PRO_PRODUCT_ID=prod_REPLACE_WITH_TEST_PRODUCT
STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_WITH_TEST_MONTHLY_PRICE
STRIPE_PRO_ANNUAL_PRICE_ID=price_REPLACE_WITH_TEST_ANNUAL_PRICE
# Classroom teacher-app origin (not the Calcura app or marketing origin).
APP_ORIGIN=http://127.0.0.1:5174

# Supabase Edge Functions provide SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY locally. Do not add them to this tracked example.
