{
  "name": "calcura-classroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "supabase": "supabase",
    "supabase:start": "npm run supabase -- db start",
    "supabase:stop": "npm run supabase -- stop",
    "supabase:reset": "npm run supabase -- db reset --local",
    "test:db": "npm run supabase -- test db --local",
    "test:assignment-results:local": "node tests/assignment-results-local-smoke.mjs",
    "test:assignment-analytics:local": "node tests/assignment-analytics-local-smoke.mjs",
    "types:db": "supabase gen types --local > src/types/database.generated.ts && prettier --write src/types/database.generated.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
